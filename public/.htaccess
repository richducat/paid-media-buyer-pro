# --- Salt: clean URL for the marketing landing ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^salt/?$ /salt-landing.html [L]
</IfModule>

# --- Salt landing: security headers (scoped to the file, main app untouched) ---
<IfModule mod_headers.c>
  <FilesMatch "^salt-landing\.html$">
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
  </FilesMatch>
</IfModule>
